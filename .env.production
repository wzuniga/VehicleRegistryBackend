# Plantilla de variables de entorno para producción.
# Copiar a .env en el servidor (`cp .env.production .env`) y completar con
# los valores reales — NUNCA subir el .env real con credenciales al repositorio.

# Database (Postgres)
# IMPORTANTE: si la contraseña contiene '#', debe ir entre comillas simples,
# si no dotenv corta el valor ahí (todo lo que sigue al '#' se pierde en silencio).
# DB_DATABASE=postgres: es la base default del servidor (compartida con otras apps,
# cada una en su propio schema), NO una base separada. Los datos de esta app viven
# en los schemas "public" y "auth" de esa misma base "postgres".
DB_HOST=178.128.159.83
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD='REPLACE_WITH_REAL_PASSWORD'
DB_DATABASE=postgres

# JWT (generar uno propio, ver README, nunca usar este placeholder)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://137.184.208.111/api/auth/google/callback

# Frontend URL (redirect tras login de Google / link de invitacion)
FRONTEND_URL=http://137.184.208.111

# Credits
REGISTRATION_BONUS_CREDITS=5
ADMIN_CREDITS_GRANT=15

# SMTP (envío de correos de invitación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM_NAME=Auto Check

# Server
PORT=3000
NODE_ENV=production
